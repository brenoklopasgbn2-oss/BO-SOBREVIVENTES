# ============================================================
# CHAMPIONS Z - SITE + DISCORD + API DAYZ
# Copie para .env apenas no PC local.
# No Railway, use Service > Variables > Raw Editor.
# NUNCA envie o .env real para GitHub ou para outra pessoa.
# ============================================================

# ---------- APLICACAO ----------
NODE_ENV=production
# No Railway, normalmente deixe PORT sem criar e use o valor fornecido pela plataforma.
# Para rodar localmente, descomente:
# PORT=3000

# URL PUBLICA DO SITE, SEM / NO FINAL
PUBLIC_URL=https://SEU-DOMINIO.up.railway.app
APP_NAME=CHAMPIONS Z
STORE_CURRENCY_NAME=Moedas

# ---------- SEGURANCA ----------
# Gere valores fortes executando: npm run setup:secrets
COOKIE_SECRET=COLE_UMA_CHAVE_ALEATORIA_FORTE_AQUI

# ---------- BANCO POSTGRESQL ----------
# Railway recomendado: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local exemplo: postgresql://usuario:senha@localhost:5432/dayz_store
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ---------- ADMIN ----------
ADMIN_USER=admin
ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# Opcional. Steam64 com 17 numeros que sera tratado como dono/admin.
ADMIN_STEAM64=
# Opcional. Mais de um Steam64, separados por virgula.
ADMIN_STEAM64S=

# ---------- API DO MOD / DAYZ ----------
# Necessaria para as rotas /api usadas pelo MOD.
# Gere com npm run setup:secrets e use a MESMA chave no lado do MOD.
API_KEY=COLE_A_CHAVE_DA_API_AQUI
# Mantenha false com o mod V75. Use true somente durante transição com mod antigo.
ALLOW_LEGACY_GAME_STEAM64_LOGIN=false

# ---------- MERCADO PAGO / PIX ----------
# Deixe vazio se nao for usar Pix.
MERCADOPAGO_ACCESS_TOKEN=
# Valores aceitos: auto, orders, payments. Recomendado: auto
MERCADOPAGO_API_MODE=auto
# Reservada para assinatura de webhook. A versao atual nao depende dela para confirmar pagamento.
MERCADOPAGO_WEBHOOK_SECRET=
# E-mail valido usado como fallback do pagador na API.
DEFAULT_PAYER_EMAIL=

# ---------- DISCORD ----------
# Mesmo serviço Railway inicia o site e o bot. TOKEN é obrigatório para a integração Discord.
TOKEN=COLE_O_TOKEN_DO_BOT_AQUI
CLIENT_ID=
GUILD_ID=
# PUBLIC_URL acima é usado no botão de vínculo para apontar o jogador ao site.
# Webhook geral/fallback. Pode ficar vazio se os webhooks especificos forem preenchidos.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_NAME=Minha Loja DayZ
DISCORD_WEBHOOK_AVATAR_URL=

# Vendas/Pix
DISCORD_SALES_WEBHOOK_URL=

# Rankings separados
DISCORD_RANKING_PLAYERS_VANILLA_WEBHOOK_URL=
DISCORD_RANKING_CLANS_VANILLA_WEBHOOK_URL=
DISCORD_RANKING_PLAYERS_BBP_WEBHOOK_URL=
DISCORD_RANKING_CLANS_BBP_WEBHOOK_URL=
DISCORD_RANKING_PLAYERS_GLOBAL_WEBHOOK_URL=
DISCORD_RANKING_CLANS_GLOBAL_WEBHOOK_URL=
DISCORD_RANKING_LANDS_WEBHOOK_URL=

# ---------- AGENDAMENTOS ----------
# Padrao: 09:00 no primeiro dia de cada mes
MONTHLY_REPORT_CRON=0 9 1 * *
TIMEZONE=America/Sao_Paulo

# ---------- OPCOES AVANCADAS ----------
# true = mostra categorias detectadas em produtos mesmo sem cadastro formal no organizador.
SHOW_UNREGISTERED_PRODUCT_CATEGORIES=false

# Wipe administrativo legado. MANTENHA false normalmente.
# So ative durante um wipe planejado e depois volte para false.
ENABLE_ADMIN_WIPE=false

# Protecao das migrations. MANTENHA false.
# true permite migrations que contenham comandos destrutivos detectados pelo verificador.
ALLOW_DESTRUCTIVE_MIGRATIONS=false
