TOKEN=COLE_AQUI_O_TOKEN_DO_BOT
CLIENT_ID=COLE_AQUI_O_APPLICATION_ID_DO_BOT
GUILD_ID=COLE_AQUI_O_ID_DO_SEU_SERVIDOR
# Opcional: habilita a Sobrevivente IA a pesquisar na web quando não achar resposta nas regras.
# Opção Google Programmable Search:
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Opção alternativa SerpApi:
SERPAPI_KEY=

# Tradução automática nos tickets (não precisa de chave por padrão)
TICKET_TRANSLATION_ENABLED=true
TICKET_TRANSLATION_TIMEOUT_MS=9000
# Opcional: troque apenas se usar um endpoint compatível com Google Translate.
TICKET_TRANSLATION_API_URL=https://translate.googleapis.com/translate_a/single
