<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="store-pro-v300">
  <%- include('partials/alerts') %>
  <div class="zz-cmd-strip">
    <span class="zz-cmd-dot"></span>
    <span class="zz-cmd-code">SETOR // <b><%= isVehicleCategory ? 'HANGAR' : 'ARSENAL' %></b></span>
    <span class="zz-cmd-tags"><span>Entrega no chão</span><span>Pagamento em <%= currencyName %></span><span>Vinculado ao SteamID</span></span>
  </div>
  <% 
    const fmt = (value) => Number(value || 0).toLocaleString('pt-BR');
    const categoryList = Array.isArray(categoriesDetailed) ? categoriesDetailed : (categories || []).map((name, index) => ({ name, order: index }));
    const activeMeta = categoryList.find(cat => String(cat?.name || '').toLowerCase() === String(selectedCategory || '').toLowerCase()) || null;
    const activeCategoryColor = activeMeta?.color || '#ef4444';
    const activeCategoryIcon = activeMeta?.icon || (isVehicleCategory ? '🚙' : '🧱');
    const totalProducts = Array.isArray(products) ? products.length : 0;
    const totalVehicles = Array.isArray(vehicleTemplates) ? vehicleTemplates.length : 0;
    const heroCount = isVehicleCategory ? totalVehicles : totalProducts;
    const hasPromo = (allProducts || []).some(product => product?.promo?.active);
    const categoryKey = String(selectedCategory || '').toLowerCase();
    const storeBanner = isVehicleCategory
      ? '/images/store-banners/zona-z-veiculos.png'
      : categoryKey.includes('armazen') || categoryKey.includes('diverso') || categoryKey.includes('armeiro')
        ? '/images/store-banners/zona-z-storage-diversos.png'
        : categoryKey.includes('constru')
          ? '/images/store-banners/zona-z-construcao.png'
          : '/images/store-banners/zona-z-loja-oficial.png';

    const staticItemImages = {
      Barrel_Red: '/images/items/barrel.webp',
      NailBox: '/images/items/nailbox.webp',
      WoodenPlank: '/images/items/woodenplank.webp',
      MetalWire: '/images/items/metalwire.webp',
      Rope: '/images/items/rope.webp',
      CamoNet: '/images/items/camonet.webp',
      Spotlight: '/images/items/spotlight.webp',
      PowerGenerator: '/images/items/powergenerator.webp',
      CableReel: '/images/items/cablereel.webp',
      WoodenCrate: '/images/items/woodencrate.webp',
      SeaChest: '/images/items/seachest.webp'
    };

    const previewForItem = (item, fallbackName) => {
      const rawClassname = String(item?.classname || '').trim();
      if (staticItemImages[rawClassname]) return staticItemImages[rawClassname];
      const classname = encodeURIComponent(rawClassname);
      const name = encodeURIComponent(String(item?.label || fallbackName || item?.classname || 'Item').trim());
      if (!classname) return '/images/no-real-image.svg';
      return `/dayz-wiki-image?type=${classname}&name=${name}`;
    };

    const productPreview = (product, itemList) => {
      if (product?.hasImageData) return `/product-image/${product.id}`;
      if (product?.imageUrl) return product.imageUrl;
      if (Array.isArray(itemList) && itemList.length) return previewForItem(itemList[0], product?.name);
      if (product?.classname) return previewForItem({ classname: product.classname, label: product.name }, product?.name);
      return '/images/no-real-image.svg';
    };

    const vehiclePreview = (vehicle) => {
      if (vehicle?.hasImageData) return `/vehicle-image/${vehicle.id}`;
      if (vehicle?.imageUrl) return vehicle.imageUrl;
      return '/images/no-real-image.svg';
    };
  %>

  <section class="zz-store-hero" style="--hero-image:url('<%= storeBanner %>');--category-accent:<%= activeCategoryColor %>">
    <div class="zz-hero-art" aria-hidden="true"></div>
    <div class="zz-hero-content">
      <div class="zz-hero-eyebrow"><span class="zz-live-dot"></span><%= appName %> STORE <i></i> <%= selectedCategory %></div>
      <h1><%= isVehicleCategory ? 'Domine a estrada.' : 'Equipe. Construa. Sobreviva.' %></h1>
      <p><%= isVehicleCategory
        ? 'Escolha seu veículo, versão e seguro em uma experiência rápida. O preset é montado automaticamente no servidor.'
        : 'Catálogo direto ao ponto: itens organizados, preços claros e entrega física no servidor sem complicação.' %></p>
      <div class="zz-hero-actions">
        <a href="#catalogo" class="zz-primary-cta">Explorar catálogo <span>→</span></a>
        <a href="/wallet" class="zz-secondary-cta">Adicionar <%= currencyName %></a>
      </div>
      <div class="zz-hero-metrics">
        <div><small>CATÁLOGO</small><strong><%= heroCount %></strong><span>itens disponíveis</span></div>
        <div><small>ENTREGA</small><strong>RÁPIDA</strong><span>online ou pendente</span></div>
        <div><small>STATUS</small><strong><%= hasPromo ? 'PROMO' : 'ONLINE' %></strong><span><%= hasPromo ? 'ofertas ativas' : 'sistema operacional' %></span></div>
      </div>
    </div>
    <aside class="zz-hero-terminal">
      <div class="zz-terminal-head"><span>TERMINAL // <%= appName %></span><b>LIVE</b></div>
      <div class="zz-terminal-main">
        <span class="zz-terminal-icon"><%= activeCategoryIcon %></span>
        <small>VOCÊ ESTÁ EM</small>
        <strong><%= selectedCategory %></strong>
        <p><%= isVehicleCategory ? 'Selecione a versão antes de concluir sua compra.' : 'Sua compra será preparada para entrega no servidor.' %></p>
      </div>
      <div class="zz-terminal-list">
        <span><i></i> Pagamento com <%= currencyName %></span>
        <span><i></i> Compra vinculada ao SteamID</span>
        <span><i></i> Catálogo atualizado pela administração</span>
      </div>
    </aside>
  </section>

  <section class="zz-category-shell" id="categorias">
    <div class="zz-category-intro">
      <span>NAVEGAÇÃO RÁPIDA</span>
      <strong>Escolha uma categoria</strong>
    </div>
    <nav class="store-categories-v300 zz-category-dock" aria-label="Categorias da loja">
      <% categoryList.forEach(cat => {
        const name = String(cat?.name || '');
        const key = name.toLowerCase();
        const vip = key.includes('vip');
        const active = String(selectedCategory).toLowerCase() === key;
      %>
        <a class="<%= active ? 'active' : '' %>" href="<%= vip ? '/outfits' : ('/shop?category=' + encodeURIComponent(name)) %>" style="--cat-color:<%= cat?.color || '#ef4444' %>">
          <span class="cat-icon-v300"><%= cat?.icon || '📦' %></span>
          <span class="cat-text-v300"><b><%= name %></b><small><%= vip ? 'Coleção premium' : (active ? 'Categoria atual' : 'Ver catálogo') %></small></span>
          <span class="zz-cat-arrow">→</span>
        </a>
      <% }) %>
    </nav>
  </section>

  <% if (starterKit?.enabled) { %>
    <section class="starter-kit-v225 zz-starter-kit" style="--starter-image:url('/images/store-banners/zona-z-kits-iniciais.png')">
      <div class="starter-kit-head-v225">
        <div>
          <span>🎁 NOVO PLAYER • RESGATE ÚNICO</span>
          <h2><%= starterKit.name || 'Kit Inicial' %></h2>
          <p><%= starterKit.description || 'Kit grátis para começar no servidor.' %></p>
        </div>
        <div class="starter-kit-status-v225 <%= starterKitClaimed ? 'claimed' : '' %>">
          <small>STATUS</small>
          <strong><%= starterKitClaimed ? 'JÁ RESGATADO' : 'GRÁTIS' %></strong>
          <span><%= starterKitClaimed ? 'Benefício usado nesta conta' : '1 vez por SteamID' %></span>
        </div>
      </div>

      <div class="starter-kit-body-v225">
        <div class="starter-kit-items-v225">
          <% (starterKit.items || []).forEach(item => { %>
            <div class="starter-item-v225">
              <img src="<%= previewForItem(item, item.label) %>" alt="<%= item.label || item.classname %>" loading="lazy" onerror="this.src='/images/no-real-image.svg'">
              <div>
                <b><%= item.label || item.classname %></b>
                <small><%= item.randomClassnames?.length ? 'Bandeira escolhida aleatoriamente no resgate' : item.classname %></small>
              </div>
            </div>
          <% }) %>
        </div>

        <aside class="starter-vip-v225">
          <span>VIP DE BOAS-VINDAS</span>
          <strong>7 DIAS GRÁTIS</strong>
          <p>Depois de resgatar o Kit Inicial, você escolhe <b>1 traje VIP</b> por 7 dias. O benefício grátis é somente na versão com <b>Assault Pack de 80 slots</b>.</p>
          <% if (starterKitClaimed) { %>
            <a href="/outfits">ESCOLHER TRAJE VIP</a>
          <% } else if (player) { %>
            <form method="POST" action="/starter-kit/claim">
              <input type="hidden" name="serverType" value="vanilla">
              <button type="submit">RESGATAR KIT INICIAL</button>
            </form>
          <% } else { %>
            <a href="/login">ABRIR PELO JOGO</a>
          <% } %>
        </aside>
      </div>
    </section>
  <% } %>

  <% if (isVehicleCategory) { %>
    <section class="store-section-head-v300" id="catalogo">
      <div><span><%= activeCategoryIcon %> <%= selectedCategory %></span><h2>Veículos disponíveis</h2></div>
      <p>Escolha a versão quando houver. O primeiro mês do seguro já vem incluso nos veículos configurados nesta loja.</p>
    </section>

    <section class="vehicle-grid-v300">
      <% vehicleTemplates.forEach(v => {
        const plans = (v.insurancePlans?.length ? v.insurancePlans : globalVehiclePlans) || [];
        const variants = Array.isArray(v.variants) && v.variants.length
          ? v.variants
          : [{ name: 'Padrão', vehicleClassname: v.vehicleClassname, imageUrl: vehiclePreview(v) }];
        const firstVariant = variants[0];
        const currentPreview = firstVariant?.imageUrl || vehiclePreview(v);
        const cargoLabel = Array.isArray(v.cargoItems) && v.cargoItems.length
          ? (v.cargoItems[0].label || `${v.cargoItems[0].quantity || 0} slots`)
          : 'Preset local do servidor';
        const vehicleVideoMap = {
          'zil-130-flatbed-gerph-green': '/videos/vehicles/zil-130-flatbed.mp4',
          'zil-130-ragz-olive': '/videos/vehicles/zil-130-olive.mp4',
          'bmw-525i-e34-color-pack': '/videos/vehicles/bmw-525i-e34.mp4',
          'land-rover-defender-110-color-pack': '/videos/vehicles/land-rover-defender-110.mp4',
          'vaz-2107-color-pack': '/videos/vehicles/vaz-2107.mp4',
          'uaz-469-m-rest': '/videos/vehicles/uaz-469-m-rest.mp4',
          'baja-bug-color-pack': '/videos/vehicles/baja-bug.mp4',
          'gaz69-rag': '/videos/vehicles/gaz69.mp4'
        };
        const vehicleVideo = vehicleVideoMap[v.slug] || null;
      %>
        <article class="vehicle-card-v300" data-vehicle-card>
          <div class="vehicle-media-v300">
            <% if (vehicleVideo) { %>
              <video src="<%= vehicleVideo %>" autoplay muted loop playsinline preload="metadata" aria-label="Vídeo <%= v.name %>"></video>
            <% } else { %>
              <img src="<%= currentPreview %>" alt="<%= v.name %>" loading="lazy" onerror="this.src='/images/no-real-image.svg'">
            <% } %>
            <div class="vehicle-badges-stack-v300">
              <span class="vehicle-badge-v300">PRESET LOCAL</span>
              <span class="vehicle-badge-v300 soft"><%= cargoLabel %></span>
              <% if (variants.length > 1) { %><span class="vehicle-badge-v300 soft"><%= variants.length %> VERSÕES</span><% } %>
            </div>
          </div>

          <div class="vehicle-body-v300">
            <div class="vehicle-heading-v300">
              <div><small>VEÍCULO</small><h3><%= v.name %></h3></div>
              <div class="vehicle-price-v300"><small>COMPRA</small><strong><%= fmt(v.buyPriceCoins) %> <%= currencyName %></strong></div>
            </div>

            <p><%= v.description || 'Veículo configurado para montagem automática pelo mod.' %></p>

            <% if (variants.length > 1) { %>
              <div class="vehicle-variant-box-v300">
                <label>Cor / versão
                  <select class="vehicle-variant-select-v300" data-vehicle-variant-select>
                    <% variants.forEach((variant, variantIndex) => { %>
                      <option value="<%= variantIndex %>" data-classname="<%= variant.vehicleClassname %>"><%= variant.name %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
            <% } %>

            <div class="vehicle-class-v300"><small>CHASSI SELECIONADO</small><code data-vehicle-classname><%= firstVariant?.vehicleClassname || v.vehicleClassname %></code></div>

            <% if (plans.length) { %>
              <div class="vehicle-insurance-v300">
                <small>SEGURO APÓS O 1º MÊS</small>
                <strong><%= fmt(plans[0]?.priceCoins || 0) %> <%= currencyName %> / 30 dias</strong>
              </div>
            <% } %>

            <% if (player) { %>
              <div class="vehicle-actions-v300">
                <% if (plans.length) { %>
                  <form method="POST" action="/vehicles/buy/<%= v.id %>" class="vehicle-form-v300">
                    <input type="hidden" name="ownershipType" value="OWNED">
                    <input type="hidden" name="variantIndex" value="0" data-vehicle-variant-input>
                    <label>Plano de seguro
                      <select name="insurancePlanId">
                        <% plans.forEach(plan => { %><option value="<%= plan.id %>"><%= plan.name %> • <%= fmt(plan.priceCoins) %> <%= currencyName %>/mês</option><% }) %>
                      </select>
                    </label>
                    <button class="store-btn-v300" type="submit">Comprar • <%= fmt(v.buyPriceCoins) %> <%= currencyName %></button>
                  </form>
                <% } %>

                <% if (Number(v.noInsurancePriceCoins || 0) > 0) { %>
                  <form method="POST" action="/vehicles/buy/<%= v.id %>">
                    <input type="hidden" name="ownershipType" value="OWNED">
                    <input type="hidden" name="insurancePlanId" value="NONE">
                    <input type="hidden" name="variantIndex" value="0" data-vehicle-variant-input>
                    <button class="store-btn-v300 secondary" type="submit">Sem seguro • <%= fmt(v.noInsurancePriceCoins) %> <%= currencyName %></button>
                  </form>
                <% } %>
              </div>
            <% } else { %>
              <a class="store-btn-v300" href="/login">Abrir pelo jogo</a>
            <% } %>
          </div>
        </article>
      <% }) %>

      <% if (!vehicleTemplates.length) { %><div class="store-empty-v300"><strong>Nenhum veículo cadastrado.</strong><span>O catálogo está pronto para receber os próximos veículos.</span></div><% } %>
    </section>
  <% } else { %>
    <section class="store-section-head-v300" id="catalogo">
      <div><span><%= activeCategoryIcon %> <%= selectedCategory %></span><h2>Itens disponíveis</h2></div>
      <p><%= products.length %> produto(s) ativos com entrega física direta no chão.</p>
    </section>

    <section class="product-grid-v300">
      <% products.forEach(product => {
        const itemList = product.items?.length ? product.items : [{ classname: product.classname, quantity: product.quantity, label: product.name }];
        const preview = productPreview(product, itemList);
      %>
        <article class="product-card-v300" style="--accent:<%= product.highlightColor || activeCategoryColor %>">
          <div class="product-media-v300">
            <img src="<%= preview %>" alt="<%= product.name %>" loading="lazy" onerror="this.src='/images/no-real-image.svg'">
            <div class="product-overlay-v300"></div>
            <div class="product-badges-v300">
              <span><%= product.category %></span><span>NO CHÃO</span>
              <% if (product.promo?.active) { %><span class="promo"><%= product.promo.percent %>% OFF</span><% } %>
            </div>
          </div>

          <div class="product-body-v300">
            <div class="product-title-row-v300">
              <div><small>PRODUTO</small><h3><%= product.name %></h3></div>
              <div class="product-price-v300">
                <% if (product.promo?.active) { %><small><s><%= fmt(product.basePriceCoins) %> <%= currencyName %></s></small><% } %>
                <strong><%= fmt(product.displayPriceCoins ?? product.priceCoins) %> <%= currencyName %></strong>
              </div>
            </div>

            <p><%= product.description || 'Item pronto para entrega direta no servidor.' %></p>
            <div class="product-meta-v300">
              <% itemList.slice(0, 5).forEach(item => { %><code><%= item.quantity %>x <%= item.label || item.classname %></code><% }) %>
              <% if (itemList.length > 5) { %><code>+<%= itemList.length - 5 %> item(ns)</code><% } %>
            </div>

            <div class="product-footer-v300">
              <div class="product-footer-note-v300"><small>CLASSNAME BASE</small><span><%= itemList[0]?.classname || product.classname || '—' %></span></div>
              <% if (player) { %>
                <form method="GET" action="/shop/confirm/<%= product.id %>"><input type="hidden" name="quantity" value="1"><button class="store-btn-v300" type="submit">Comprar</button></form>
              <% } else { %>
                <a class="store-btn-v300" href="/login">Abrir pelo jogo</a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!products.length) { %><div class="store-empty-v300"><strong>Nenhum item nesta categoria.</strong><span>O catálogo está pronto para receber os próximos itens.</span></div><% } %>
    </section>
  <% } %>
</main>


<script data-vehicle-variants-v300>
(() => {
  const cards = Array.from(document.querySelectorAll('[data-vehicle-card]'));
  cards.forEach((card) => {
    const select = card.querySelector('[data-vehicle-variant-select]');
    if (!select) return;
    const classname = card.querySelector('[data-vehicle-classname]');
    const sync = () => {
      const option = select.options[select.selectedIndex];
      const value = String(select.value || '0');
      card.querySelectorAll('[data-vehicle-variant-input]').forEach(input => input.value = value);
      if (classname && option?.dataset?.classname) classname.textContent = option.dataset.classname;
    };
    select.addEventListener('change', sync);
    sync();
  });
})();
</script>
<%- include('partials/footer') %>
