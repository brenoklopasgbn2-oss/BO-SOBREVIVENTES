<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container starter-kit-admin-clean-v200">
  <%- include('_admin_nav') %>
  <%- include('../partials/alerts') %>
  <section class="card">
    <p class="eyebrow">Kit Inicial</p>
    <h1>Configuração limpa</h1>
    <p class="muted">O kit começa desativado nesta base. Quando ativado, todos os itens são entregues <b>direto no chão</b>.</p>
    <form method="POST" action="/admin/starter-kit" class="form-grid">
      <label class="check-row"><input type="checkbox" name="enabled" <%= kit.enabled ? 'checked' : '' %>><span>Ativar Kit Inicial</span></label>
      <div class="inline-grid two-cols">
        <label>Nome<input name="name" value="<%= kit.name || 'Kit Inicial' %>" required></label>
        <label>Servidor<select name="serverType"><option value="current" <%= kit.serverType==='current'?'selected':'' %>>Servidor atual</option><option value="vanilla" <%= kit.serverType==='vanilla'?'selected':'' %>>Vanilla</option><option value="bbp" <%= kit.serverType==='bbp'?'selected':'' %>>Vanilla+</option></select></label>
        <label>Bônus <%= currencyName %><input name="bonusCoins" type="number" min="0" max="1000000" value="<%= kit.bonusCoins || 0 %>"></label>
      </div>
      <label>Descrição<textarea name="description"><%= kit.description || '' %></textarea></label>
      <div class="card" style="border-color:rgba(34,197,94,.35)"><strong>⬇️ Entrega fixa no chão</strong><p class="muted">Sem caixa temporária e sem type de container.</p></div>
      <label>Itens <small class="muted">Classname|Quantidade|Nome</small><textarea name="itemsText" class="items-textarea" placeholder="NailBox|1|Caixa de pregos"><%= starterKitItemsToText(kit.items) %></textarea></label>
      <button class="btn primary">Salvar</button>
    </form>
  </section>
  <section class="card mt">
    <h2>Teste</h2>
    <form method="POST" action="/admin/starter-kit/test-drop" class="inline-grid two-cols"><label>Steam64<input name="steam64" maxlength="17" required></label><label>Servidor<select name="serverType"><option value="vanilla">Vanilla</option><option value="bbp">Vanilla+</option></select></label><button class="btn primary">Testar drop no chão</button></form>
  </section>
</main>
<%- include('../partials/footer') %>
