<%- include('../partials/head') %><link rel="stylesheet" href="/css/admin-v46.css"><%- include('_admin_nav') %>
<main class="admin-page-v46" style="padding:24px"><%- include('../partials/alerts') %>
<h1>🏆 Campeonato CHAMPIONS Z</h1><p>Controle de bandeiras, clãs, resultados, pontos, imagens e publicação automática no Discord.</p>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">
<section class="admin-card-v46" style="padding:18px"><h2>Registrar resultado de evento</h2><form method="POST" action="/admin/championship/results" enctype="multipart/form-data" style="display:grid;gap:10px">
<label>Clã campeão<select name="clanId" required><option value="">Selecione</option><% clans.filter(c=>c.championshipRegistered).forEach(c=>{ %><option value="<%= c.id %>">[<%= c.tag %>] <%= c.name %> — <%= c.championshipPoints %> pts</option><% }) %></select></label>
<label>Evento<input name="eventName" required placeholder="Ex.: Mega KOTH"></label><label>Título<input name="title" placeholder="CAMPEÕES DO MEGA KOTH"></label><label>Pontos<input name="points" type="number" required value="100"></label><label>Descrição<textarea name="description" rows="4" placeholder="Resumo do resultado..."></textarea></label><label>Imagem/banner<input type="file" name="eventImage" accept="image/*"></label><label>ADM responsável<input name="adminActor" placeholder="atividade_047"></label><button class="btn primary" type="submit">Salvar + publicar no Discord</button></form></section>
<section class="admin-card-v46" style="padding:18px"><h2>Adicionar bandeira disponível</h2><form method="POST" action="/admin/championship/flags" enctype="multipart/form-data" style="display:grid;gap:10px"><label>Nome<input name="name" required></label><label>Classname DayZ<input name="classname"></label><label>Descrição<textarea name="description"></textarea></label><label>Imagem<input type="file" name="flagImage" accept="image/*"></label><button class="btn primary" type="submit">Adicionar bandeira</button></form><p style="margin-top:14px">Fila Discord: <b><%= outbox.pending || 0 %></b> pendente(s).</p></section>
</div>
<section class="admin-card-v46" style="padding:18px;margin-top:16px;overflow:auto"><h2>Clãs e integrantes</h2><table style="width:100%;border-collapse:collapse"><thead><tr><th>Clã</th><th>Membros</th><th>Vínculos</th><th>Pontos</th><th>Flag</th><th>Entrega</th></tr></thead><tbody><% clans.forEach(c=>{ %><tr style="border-top:1px solid #333"><td style="padding:10px"><b>[<%= c.tag %>] <%= c.name %></b><br><small><%= c.championshipRegistered ? '✅ Inscrito' : 'Não inscrito' %></small></td><td><%= c.members.map(m=>m.player?.nickname||m.steam64).join(', ') %> (<%= c.members.length %>/5)</td><td><%= c.members.filter(m=>m.player?.discordId).length %>/<%= c.members.length %></td><td><b><%= c.championshipPoints %></b></td><td><%= c.selectedFlag?.name || '-' %></td><td><%= c.flagDeliveryStatus %><% if(c.flagDeliveryStatus==='RESERVED'){ %><form method="POST" action="/admin/championship/clans/<%= c.id %>/flag-delivered"><button class="btn" type="submit">Marcar entregue</button></form><% } %></td></tr><% }) %></tbody></table></section>
<section class="admin-card-v46" style="padding:18px;margin-top:16px"><h2>Histórico de eventos</h2><% results.forEach(r=>{ %><article style="padding:12px 0;border-top:1px solid #333"><b><%= r.eventName %></b> • [<%= r.clan.tag %>] <%= r.clan.name %> • <strong><%= r.points>=0?'+':'' %><%= r.points %> pts</strong><br><small><%= new Date(r.occurredAt).toLocaleString('pt-BR') %> • ADM: <%= r.adminActor||'-' %> • Discord: <%= r.discordPublishedAt?'✅':'⏳' %></small></article><% }) %></section>
</main>
