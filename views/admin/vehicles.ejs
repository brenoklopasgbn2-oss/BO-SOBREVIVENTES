<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container admin-vehicles-clean-v200">
  <%- include('_admin_nav') %>
  <%- include('../partials/alerts') %>

  <section class="card">
    <p class="eyebrow">VEÍCULOS V200</p>
    <h1>Chassi + preset do mod</h1>
    <p class="muted">O site envia somente o <b>classname do chassi</b>. Rodas, bateria, vela, radiador, fluidos, acessórios e qualquer carga são montados pelo preset que existir nos arquivos do mod.</p>
    <div class="card" style="border-color:rgba(34,197,94,.35);margin-top:14px">
      <strong>Fluxo novo</strong>
      <p class="muted">SITE → classname do chassi → MOD procura preset com esse classname → MOD monta o veículo completo.</p>
    </div>
  </section>

  <section class="split align-start admin-vehicle-grid mt">
    <section class="card">
      <p class="eyebrow"><%= vehicle ? 'Editar' : 'Novo' %></p>
      <h2><%= vehicle ? vehicle.name : 'Cadastrar veículo' %></h2>
      <form method="POST" action="<%= vehicle ? '/admin/vehicles/' + vehicle.id : '/admin/vehicles' %>" class="form-grid">
        <label>Nome<input name="name" value="<%= vehicle?.name || '' %>" placeholder="SUV VIP" required></label>
        <label>Classname do chassi<input name="vehicleClassname" value="<%= vehicle?.vehicleClassname || '' %>" placeholder="Seu_Chassis_Classname" required></label>
        <label>Descrição<textarea name="description"><%= vehicle?.description || 'O mod monta este veículo usando o preset do classname do chassi.' %></textarea></label>
        <div class="inline-grid two-cols">
          <label>Servidor<select name="serverType"><option value="vanilla" <%= !vehicle || vehicle.serverType==='vanilla'?'selected':'' %>>Vanilla</option><option value="bbp" <%= vehicle?.serverType==='bbp'?'selected':'' %>>Vanilla+</option></select></label>
          <label>Preço <%= currencyName %><input name="buyPriceCoins" type="number" min="0" value="<%= vehicle?.buyPriceCoins || 0 %>"></label>
          <label>Preço sem seguro (opcional)<input name="noInsurancePriceCoins" type="number" min="0" value="<%= vehicle?.noInsurancePriceCoins ?? '' %>"></label>
          <label class="check-row"><input type="checkbox" name="active" <%= !vehicle || vehicle.active ? 'checked' : '' %>><span>Ativo</span></label>
        </div>
        <button class="btn primary"><%= vehicle ? 'Salvar chassi' : 'Criar veículo' %></button>
      </form>
      <% if (vehicle) { %><form method="POST" action="/admin/vehicles/<%= vehicle.id %>/delete" class="mt" onsubmit="return confirm('Excluir/remover este veículo da loja?');"><button class="btn danger">Excluir veículo</button></form><% } %>
    </section>

    <section class="card">
      <h2>Planos de seguro</h2>
      <p class="muted">O seguro continua funcionando; somente a montagem do veículo saiu do site.</p>
      <form method="POST" action="/admin/vehicle-insurance-plans" class="form-grid compact-form">
        <label>Nome<input name="name" required></label>
        <label>Veículo específico<select name="templateId"><option value="">Todos</option><% templates.forEach(v=>{ %><option value="<%= v.id %>"><%= v.name %></option><% }) %></select></label>
        <input type="hidden" name="billingType" value="SUBSCRIPTION">
        <div class="inline-grid two-cols">
          <label>Preço <%= currencyName %><input name="priceCoins" type="number" min="0" value="5000"></label>
          <label>Taxa reposição<input name="respawnFeeCoins" type="number" min="0" value="0"></label>
          <label>Duração dias<input name="durationDays" type="number" min="1" value="30"></label>
          <label>Usos/semana<input name="maxUsesPerWeek" type="number" min="1" value="5"></label>
          <label class="check-row"><input type="checkbox" name="active" checked><span>Ativo</span></label>
        </div>
        <label>Descrição<textarea name="description"></textarea></label>
        <button class="btn primary">Criar seguro</button>
      </form>
      <div style="display:grid;gap:8px;margin-top:14px"><% plans.forEach(plan=>{ %><div class="card"><strong><%= plan.name %></strong><br><small class="muted"><%= plan.template?.name || 'Todos os veículos' %> • <%= coins(plan.priceCoins) %> <%= currencyName %> • <%= plan.maxUsesPerWeek %>x/semana</small><form method="POST" action="/admin/vehicle-insurance-plans/<%= plan.id %>/toggle" class="mt"><button class="btn small"><%= plan.active ? 'Desativar' : 'Ativar' %></button></form></div><% }) %><% if(!plans.length){ %><p class="muted">Nenhum seguro cadastrado.</p><% } %></div>
    </section>
  </section>

  <section class="card mt">
    <h2>Veículos cadastrados</h2>
    <table><thead><tr><th>Nome</th><th>Chassi</th><th>Preço</th><th>Preset</th><th>Status</th><th></th></tr></thead><tbody>
      <% templates.forEach(v=>{ %><tr><td><%= v.name %></td><td><code><%= v.vehicleClassname %></code></td><td><%= coins(v.buyPriceCoins) %> <%= currencyName %></td><td><code><%= v.vehicleClassname %></code><br><small>arquivo do mod</small></td><td><%= v.active?'Ativo':'Inativo' %></td><td><a class="btn small" href="/admin/vehicles/<%= v.id %>/edit">Editar</a></td></tr><% }) %>
      <% if(!templates.length){ %><tr><td colspan="6" class="muted">Nenhum veículo. Cadastre somente o nome e o classname do chassi.</td></tr><% } %>
    </tbody></table>
  </section>

  <section class="card mt">
    <h2>Veículos dos players</h2>
    <table><thead><tr><th>Player</th><th>Veículo</th><th>ID</th><th>Seguro</th><th>Ações</th></tr></thead><tbody>
      <% playerVehicles.forEach(v=>{ %><tr><td><%= v.player?.nickname || v.steam64 %><br><small><%= v.steam64 %></small></td><td><%= v.displayName %><br><code><%= v.vehicleClassname %></code></td><td><code><%= v.currentVehicleKey || '-' %></code></td><td><%= v.insurancePlan?.name || 'Sem seguro' %></td><td><div style="display:flex;gap:6px;flex-wrap:wrap"><form method="POST" action="/admin/player-vehicles/<%= v.id %>/restore-missing"><button class="btn small primary">Restaurar mesmo ID</button></form><form method="POST" action="/admin/player-vehicles/<%= v.id %>/reset-delivery"><button class="btn small">Substituir novo ID</button></form></div></td></tr><% }) %>
      <% if(!playerVehicles.length){ %><tr><td colspan="5" class="muted">Nenhum veículo de player.</td></tr><% } %>
    </tbody></table>
  </section>

  <section class="card danger-zone-v56 mt">
    <h2>Zerar veículos/seguros</h2>
    <form method="POST" action="/admin/vehicles/reset-store" onsubmit="return confirm('Limpar veículos e seguros cadastrados?');"><button class="btn danger">Zerar veículos e seguros</button></form>
  </section>
</main>
<%- include('../partials/footer') %>
