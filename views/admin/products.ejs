<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container admin-products-clean-v200">
  <%- include('_admin_nav') %>
  <%- include('../partials/alerts') %>

  <% const categories = Array.isArray(storeCategories) ? storeCategories : []; %>
  <% const selected = selectedCategory || categories[0] || { name:'Construção', color:'#ef4444' }; %>
  <% const productItemsRows = product?.items?.length ? product.items : [{ classname:'', quantity:1, label:'' }]; %>

  <section class="card">
    <p class="eyebrow">LOJA LIMPA V200</p>
    <h1>Produtos</h1>
    <p class="muted">Todo item físico é entregue <b>direto no chão</b>. A opção de caixa foi removida por completo.</p>
    <div class="action-row-v47">
      <a class="btn <%= activeTab === 'products' ? 'primary' : '' %>" href="/admin/products?tab=products">Produtos</a>
      <a class="btn <%= activeTab === 'create' ? 'primary' : '' %>" href="/admin/products?tab=create">Novo produto</a>
      <a class="btn <%= activeTab === 'categories' ? 'primary' : '' %>" href="/admin/products?tab=categories">Categorias</a>
      <a class="btn <%= activeTab === 'promo' ? 'primary' : '' %>" href="/admin/products?tab=promo">Promoção</a>
    </div>
  </section>

  <% if (activeTab === 'products') { %>
    <section class="card mt">
      <div class="admin-v47-panel-head"><div><p class="eyebrow">Catálogo atual</p><h2>Itens cadastrados</h2></div><a class="btn primary" href="/admin/products?tab=create">+ Novo</a></div>
      <input id="adminProductSearchV200" placeholder="Buscar por nome ou classname..." style="width:100%;margin:10px 0 16px">
      <div class="outfit-grid-admin-v92">
        <% products.forEach(p => { const pItems = p.items?.length ? p.items : [{classname:p.classname,quantity:p.quantity,label:p.name}]; const searchText=[p.name,p.category,p.serverType,...pItems.map(i=>i.classname)].join(' ').toLowerCase(); %>
          <article class="card" data-product-card data-search="<%= searchText.replace(/&/g,'&amp;').replace(/\"/g,'&quot;') %>">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start">
              <div><h3 style="margin:0"><%= p.name %></h3><small class="muted"><%= p.category %> • <%= p.serverType %> • ⬇️ chão</small></div>
              <b><%= coins(p.priceCoins) %> <%= currencyName %></b>
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin:12px 0"><% pItems.forEach(i => { %><code><%= i.quantity %>x <%= i.classname %></code><% }) %></div>
            <div class="action-row-v47">
              <a class="btn small primary" href="/admin/products/<%= p.id %>/edit?tab=create">Editar</a>
              <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Excluir este produto?');"><button class="btn small danger">Excluir</button></form>
              <form method="POST" action="/admin/products/<%= p.id %>/test-drop" style="display:flex;gap:6px"><input name="steam64" maxlength="17" placeholder="Steam64 teste" required><button class="btn small">Testar chão</button></form>
            </div>
          </article>
        <% }) %>
        <% if (!products.length) { %><p class="muted">Nenhum produto cadastrado.</p><% } %>
      </div>
    </section>
  <% } %>

  <% if (activeTab === 'create') { %>
    <section class="card mt" id="productEditor">
      <p class="eyebrow"><%= product ? 'Editar produto' : 'Novo produto' %></p>
      <h2><%= product ? product.name : 'Cadastrar item' %></h2>
      <form method="POST" action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" class="form-grid">
        <div class="inline-grid two-cols">
          <label>Nome<input name="name" value="<%= product?.name || '' %>" required></label>
          <label>Categoria<select name="category" required><% categories.filter(c=>c.active!==false).forEach(c=>{ %><option value="<%= c.name %>" <%= (product?.category || selected.name) === c.name ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
          <label>Servidor<select name="serverType"><option value="vanilla" <%= !product || product.serverType==='vanilla' ? 'selected' : '' %>>Vanilla</option><option value="bbp" <%= product?.serverType==='bbp' ? 'selected' : '' %>>Vanilla+</option><option value="all" <%= product?.serverType==='all' ? 'selected' : '' %>>Todos</option></select></label>
          <label>Preço <%= currencyName %><input name="priceCoins" type="number" min="0" value="<%= product?.priceCoins || 0 %>" required></label>
          <label>Estoque vazio = infinito<input name="stock" type="number" min="0" value="<%= product?.stock ?? '' %>"></label>
          <label>Status<select name="status"><option value="ACTIVE" <%= !product || product.status==='ACTIVE' ? 'selected' : '' %>>Ativo</option><option value="INACTIVE" <%= product?.status==='INACTIVE' ? 'selected' : '' %>>Inativo</option></select></label>
        </div>
        <label>Descrição<textarea name="description"><%= product?.description || '' %></textarea></label>

        <div class="card" style="border-color:rgba(34,197,94,.35)">
          <strong>⬇️ Entrega fixa: DIRETO NO CHÃO</strong>
          <p class="muted">Não existe mais seleção de caixa e nenhum type de container é enviado ao mod.</p>
        </div>

        <h3>Itens entregues</h3>
        <div id="itemRows" style="display:grid;gap:8px">
          <% productItemsRows.forEach(item => { %>
            <div data-row class="inline-grid" style="grid-template-columns:minmax(220px,1fr) 100px minmax(180px,1fr) auto">
              <input name="itemClassname[]" value="<%= item.classname || '' %>" placeholder="Classname" required>
              <input name="itemQuantity[]" type="number" min="1" value="<%= item.quantity || 1 %>" required>
              <input name="itemLabel[]" value="<%= item.label || '' %>" placeholder="Nome visível">
              <button type="button" class="btn danger small item-remove">✕</button>
            </div>
          <% }) %>
        </div>
        <button type="button" class="btn" id="addItemRow">+ Adicionar classname</button>

        <div class="inline-grid two-cols">
          <label class="check-row"><input name="featured" type="checkbox" <%= product?.featured ? 'checked' : '' %>><span>Destacar</span></label>
          <label>Cor destaque<input name="highlightColor" type="color" value="<%= product?.highlightColor || '#ef4444' %>"></label>
          <label class="check-row"><input name="promoActive" type="checkbox" <%= product?.promoActive ? 'checked' : '' %>><span>Promoção própria</span></label>
          <label>Desconto %<input name="promoPercent" type="number" min="0" max="95" value="<%= product?.promoPercent || 0 %>"></label>
          <label>Texto promoção<input name="promoLabel" value="<%= product?.promoLabel || '' %>"></label>
          <label>Cor promoção<input name="promoColor" type="color" value="<%= product?.promoColor || '#ff7a18' %>"></label>
        </div>
        <button class="btn primary" type="submit"><%= product ? 'Salvar produto' : 'Criar produto' %></button>
      </form>
    </section>
  <% } %>

  <% if (activeTab === 'categories') { %>
    <section class="card mt">
      <p class="eyebrow">Categorias</p><h2>Organização da loja</h2>
      <div class="outfit-grid-admin-v92">
        <% categories.forEach(c => { %><form method="POST" action="/admin/categories" class="card"><input type="hidden" name="originalName" value="<%= c.name %>"><input type="hidden" name="originalServerType" value="<%= c.serverType || 'all' %>"><label>Nome<input name="name" value="<%= c.name %>" required></label><label>Servidor<select name="serverType"><option value="vanilla" <%= c.serverType==='vanilla'?'selected':'' %>>Vanilla</option><option value="bbp" <%= c.serverType==='bbp'?'selected':'' %>>Vanilla+</option><option value="all" <%= c.serverType==='all'?'selected':'' %>>Todos</option></select></label><input type="hidden" name="icon" value="<%= c.icon || '📦' %>"><input type="hidden" name="color" value="<%= c.color || '#ef4444' %>"><input type="hidden" name="order" value="<%= c.order || 10 %>"><input type="hidden" name="active" value="true"><button class="btn">Salvar</button></form><% }) %>
      </div>
      <form method="POST" action="/admin/categories" class="form-grid mt"><h3>Nova categoria</h3><div class="inline-grid two-cols"><label>Nome<input name="name" required></label><label>Servidor<select name="serverType"><option value="vanilla">Vanilla</option><option value="bbp">Vanilla+</option><option value="all">Todos</option></select></label></div><input type="hidden" name="icon" value="📦"><input type="hidden" name="color" value="#ef4444"><input type="hidden" name="active" value="true"><button class="btn primary">Criar categoria</button></form>
    </section>
  <% } %>

  <% if (activeTab === 'promo') { %>
    <section class="card mt"><p class="eyebrow">Promoção</p><h2>Promoção global</h2><form method="POST" action="/admin/promo/global" class="form-grid"><label class="check-row"><input name="enabled" type="checkbox" <%= globalPromo?.enabled ? 'checked' : '' %>><span>Ativar</span></label><div class="inline-grid two-cols"><label>Desconto %<input name="percent" type="number" min="0" max="95" value="<%= globalPromo?.percent || 0 %>"></label><label>Texto<input name="label" value="<%= globalPromo?.label || '' %>"></label><label>Cor<input name="color" type="color" value="<%= globalPromo?.color || '#ff7a18' %>"></label></div><button class="btn primary">Salvar</button></form></section>
  <% } %>
</main>
<script>
(function(){
  const rows=document.getElementById('itemRows');
  function bind(btn){btn.addEventListener('click',()=>{const all=rows?.querySelectorAll('[data-row]')||[];if(all.length>1)btn.closest('[data-row]')?.remove();});}
  document.querySelectorAll('.item-remove').forEach(bind);
  document.getElementById('addItemRow')?.addEventListener('click',()=>{const d=document.createElement('div');d.setAttribute('data-row','');d.className='inline-grid';d.style.gridTemplateColumns='minmax(220px,1fr) 100px minmax(180px,1fr) auto';d.innerHTML='<input name="itemClassname[]" placeholder="Classname" required><input name="itemQuantity[]" type="number" min="1" value="1" required><input name="itemLabel[]" placeholder="Nome visível"><button type="button" class="btn danger small item-remove">✕</button>';rows.appendChild(d);bind(d.querySelector('.item-remove'));});
  const search=document.getElementById('adminProductSearchV200');search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();document.querySelectorAll('[data-product-card]').forEach(card=>card.style.display=!q||card.dataset.search.includes(q)?'':'none');});
})();
</script>
<%- include('../partials/footer') %>
