    <a class="<%= adminPath === '/admin' ? 'active' : '' %>" href="/admin"><span>▦</span><b>Dashboard</b></a>
    <a class="ftp-admin-link-v88 <%= adminPath.startsWith('/admin/ftp') ? 'active' : '' %>" href="/admin/ftp"><span>🔌</span><b>API DO SERVIDOR</b><small>Status do mod</small></a>
    <a class="<%= adminPath.startsWith('/admin/links') ? 'active' : '' %>" href="/admin/links"><span>🔗</span><b>Vínculos</b><small>Discord ↔ Steam</small></a>
