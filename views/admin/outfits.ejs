<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="admin-vip-clean-v200">
  <%- include('../partials/alerts') %>
  <% const fmt = value => Number(value || 0).toLocaleString('pt-BR'); %>
  <% const editingItems = editing ? outfitItemsToText(editing.items || []) : ''; %>
  <%
    const catalogGroups = [];
    const catalogGroupMap = new Map();
    for (const outfit of (catalogOutfits || [])) {
      const rawName = String(outfit.name || 'Traje VIP');
      const parts = rawName.split(' • ');
      const baseName = parts.length > 1 ? parts[0].trim() : rawName;
      const variantName = parts.length > 1 ? parts.slice(1).join(' • ').trim() : rawName;
      const key = `${baseName}||${outfit.imageUrl || ''}`;
      if (!catalogGroupMap.has(key)) {
        const group = { key, name: baseName, imageUrl: outfit.imageUrl || '', variants: [] };
        catalogGroupMap.set(key, group);
        catalogGroups.push(group);
      }
      catalogGroupMap.get(key).variants.push({ ...outfit, variantName });
    }
  %>
  <section class="admin-vip-hero-v200">
    <div><span>PAINEL VIP • CLEAN V200</span><h1>Trajes com vídeo + payload avançado</h1><p>Sem imagens antigas. O campo de mídia aceita vídeo; os itens suportam percentual de líquido e acoplados.</p></div>
    <form method="POST" action="/admin/outfits/sync-all-vips"><button type="submit">Atualizar VIPs na API</button></form>
  </section>

  <section class="admin-vip-layout-v200">
    <form method="POST" action="<%= editing ? ('/admin/outfits/' + editing.id) : '/admin/outfits' %>" class="admin-vip-form-v200">
      <div class="admin-vip-title-v200"><div><span><%= editing ? 'EDITANDO' : 'NOVO TRAJE' %></span><h2><%= editing ? editing.name : 'Cadastrar VIP' %></h2></div><% if (editing) { %><a href="/admin/outfits">Cancelar edição</a><% } %></div>
      <label>Nome<input name="name" value="<%= editing?.name || '' %>" required></label>
      <label>Descrição<textarea name="description" rows="3"><%= editing?.description || '' %></textarea></label>
      <div class="admin-vip-row-v200">
        <label>Preço <%= currencyName %><input type="number" min="0" name="priceCoins" value="<%= editing?.priceCoins ?? 0 %>"></label>
        <label>Duração (dias)<input type="number" min="1" max="3650" name="durationDays" value="<%= editing?.durationDays ?? 30 %>" required></label>
        <label>Nível<input type="number" min="1" max="99" name="level" value="<%= editing?.level ?? 1 %>"></label>
      </div>
      <input type="hidden" name="serverType" value="vanilla">
      <label>Vídeo do traje (.mp4 / .webm ou URL)
        <input name="videoUrl" value="<%= editing?.imageUrl || '' %>" placeholder="/videos/vips/traje-nome.mp4">
        <small>O vídeo toca automaticamente, sem som e fica em loop contínuo enquanto o player estiver visualizando o traje.</small>
      </label>
      <label>Itens do traje
        <textarea name="itemsText" rows="12" required placeholder="Body|VIP_Jacket|1|Jaqueta VIP||Radio@WalkieTalkie@1
inventory|GlassBottle|1|Garrafa|50|"><%= editingItems %></textarea>
      </label>
      <div class="admin-vip-format-v200">
        <strong>Formato:</strong> <code>slot|classname|qtd|nome|liquido%|acoplados</code>
        <span>Acoplados separados por vírgula. Cada um aceita <code>Classname@Slot@Qtd@%</code>. Para item dentro de outro, use <code>Bainha@@1@&gt;CombatKnife@@1@</code>.</span>
      </div>
      <div class="admin-vip-checks-v200">
        <label><input type="checkbox" name="active" <%= editing ? (editing.active ? 'checked' : '') : 'checked' %>> Ativo</label>
        <label><input type="checkbox" name="isPrivate" <%= editing?.isPrivate ? 'checked' : '' %>> VIP privado/oculto</label>
      </div>
      <label>Steam64 privados para liberar agora (opcional)<textarea name="privateSteamIds" rows="3" placeholder="7656119..."></textarea></label>
      <button class="admin-vip-save-v200" type="submit"><%= editing ? 'Salvar traje' : 'Criar traje' %></button>
    </form>

    <aside class="admin-vip-list-v200">
      <div class="admin-vip-list-head-v200">
        <div><span>CATÁLOGO ATUAL</span><h2><%= catalogGroups.length %> traje(s)</h2></div>
        <small>Somente os 11 trajes VIP novos. As mochilas são opções do mesmo traje.</small>
      </div>

      <% catalogGroups.forEach(group => { const allActive = group.variants.every(v => v.active); %>
        <article class="admin-vip-card-v200 admin-vip-group-v613">
          <div class="admin-vip-card-head-v200">
            <strong><%= group.name %></strong>
            <span class="<%= allActive ? 'on' : 'off' %>"><%= allActive ? 'ATIVO' : 'PARCIAL' %></span>
          </div>
          <small><%= group.variants.length %> opções de mochila • 1 único traje na loja</small>
          <code><%= group.imageUrl || 'sem vídeo ainda' %></code>

          <div class="admin-vip-manual-grant-v614">
            <div class="admin-vip-manual-head-v614">
              <div><span>SETAR VIP MANUAL</span><strong>Escolha a bolsa que o player vai receber</strong></div>
              <small>O traje continua sendo <%= group.name %>; somente a mochila muda.</small>
            </div>
            <form method="POST" action="/admin/outfits/grant-manual" class="admin-vip-grant-manual-form-v614">
              <label>Bolsa
                <select name="outfitId" required>
                  <% group.variants.forEach(variant => { const backItem = (Array.isArray(variant.items) ? variant.items : []).find(item => ['back','backpack'].includes(String(item.slot || '').toLowerCase())); %>
                    <option value="<%= variant.id %>"><%= backItem?.label || variant.variantName %></option>
                  <% }) %>
                </select>
              </label>
              <label>Steam64<input name="steam64" pattern="[0-9]{17}" maxlength="17" placeholder="7656119..." required></label>
              <label>Nick<input name="nickname" placeholder="Nick opcional"></label>
              <label>Dias<input name="durationDays" type="number" min="1" max="3650" value="<%= group.variants[0]?.durationDays || 30 %>" required></label>
              <button type="submit">Setar <%= group.name %></button>
            </form>
          </div>

          <details class="admin-vip-variants-details-v614">
            <summary>Ver/editar as <%= group.variants.length %> opções de bolsa</summary>
            <div class="admin-vip-variants-v613">
              <% group.variants.forEach(variant => { const items = Array.isArray(variant.items) ? variant.items : []; const backItem = items.find(item => ['back','backpack'].includes(String(item.slot || '').toLowerCase())); %>
                <div class="admin-vip-variant-v613">
                  <div class="admin-vip-variant-main-v613">
                    <b><%= backItem?.label || variant.variantName %></b>
                    <small><%= fmt(variant.priceCoins) %> <%= currencyName %> • <%= variant.durationDays %> dias</small>
                  </div>
                  <div class="admin-vip-actions-v200">
                    <a href="/admin/outfits?edit=<%= variant.id %>">Editar</a>
                    <form method="POST" action="/admin/outfits/<%= variant.id %>/toggle"><button type="submit"><%= variant.active ? 'Desativar' : 'Ativar' %></button></form>
                  </div>
                  <details class="admin-vip-variant-access-v613">
                    <summary>Ver itens</summary>
                    <div class="admin-vip-mini-items-v200"><% items.slice(0,6).forEach(item => { %><span><%= item.classname %></span><% }) %></div>
                  </details>
                </div>
              <% }) %>
            </div>
          </details>
        </article>
      <% }) %>

      <% if (!catalogGroups.length) { %>
        <div class="admin-vip-empty-v200">Nenhum dos 11 trajes atuais foi encontrado.</div>
      <% } %>

      <% if ((adminOutfits || []).length) { %>
        <div class="admin-vip-list-head-v200 admin-vip-admin-head-v613"><div><span>ADMIN</span><h2>Traje bloqueado</h2></div></div>
        <% adminOutfits.forEach(outfit => { const items = Array.isArray(outfit.items) ? outfit.items : []; %>
          <article class="admin-vip-card-v200 admin-vip-admin-card-v613">
            <div class="admin-vip-card-head-v200"><strong><%= outfit.name %></strong><span class="on">ADMIN ONLY</span></div>
            <small>Oculto da loja • não entra na contagem dos 11 VIPs</small>
            <div class="admin-vip-mini-items-v200"><% items.slice(0,8).forEach(item => { %><span><%= item.classname %></span><% }) %></div>
            <div class="admin-vip-actions-v200"><a href="/admin/outfits?edit=<%= outfit.id %>">Editar</a></div>
            <details><summary>Setar para um player</summary>
              <form method="POST" action="/admin/outfits/<%= outfit.id %>/grant" class="admin-vip-grant-v200"><input name="steam64" pattern="[0-9]{17}" maxlength="17" placeholder="Steam64" required><input name="nickname" placeholder="Nick opcional"><input name="durationDays" type="number" min="1" max="3650" value="3650"><button type="submit">Liberar/Renovar ADMIN</button></form>
            </details>
          </article>
        <% }) %>
      <% } %>
    </aside>
  </section>

  <% if (activeSubs?.length) { %>
    <section class="admin-vip-active-v200"><h2>Assinaturas ativas</h2><div><% activeSubs.forEach(sub => { %><article><span><strong><%= sub.player?.nickname || sub.steam64 %></strong><small><%= sub.outfitTemplate?.name %> • até <%= new Date(sub.expiresAt).toLocaleString('pt-BR') %></small></span><form method="POST" action="/admin/outfits/subscriptions/<%= sub.id %>/revoke" onsubmit="return confirm('Remover TODOS os VIPs ativos deste player agora? O mod receberá a remoção no próximo poll da API.')"><button type="submit">Remover</button></form></article><% }) %></div></section>
  <% } %>
</main>
<style>
.admin-vip-clean-v200{max-width:1500px;margin:0 auto;padding:34px 28px 80px}.admin-vip-hero-v200{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:26px;border-radius:24px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(135deg,#0a101b,#19080c);margin-bottom:18px}.admin-vip-hero-v200 span,.admin-vip-title-v200 span,.admin-vip-list-head-v200 span{font-size:.68rem;font-weight:950;letter-spacing:.16em;color:#fb7185}.admin-vip-hero-v200 h1{margin:5px 0;font-size:2.2rem}.admin-vip-hero-v200 p{margin:0;color:#aeb8c7}.admin-vip-hero-v200 button,.admin-vip-save-v200{border:0;border-radius:11px;padding:12px 15px;background:#ef4444;color:#fff;font-weight:900;cursor:pointer}.admin-vip-layout-v200{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.75fr);gap:18px}.admin-vip-form-v200,.admin-vip-list-v200,.admin-vip-active-v200{border:1px solid rgba(255,255,255,.1);border-radius:22px;background:rgba(7,11,18,.94);padding:20px}.admin-vip-form-v200{display:grid;gap:13px}.admin-vip-title-v200{display:flex;align-items:center;justify-content:space-between}.admin-vip-title-v200 h2,.admin-vip-list-head-v200 h2{margin:3px 0}.admin-vip-title-v200 a{color:#fda4af}.admin-vip-form-v200 label{display:grid;gap:6px;font-size:.79rem;font-weight:850;color:#dbe4f0}.admin-vip-form-v200 input,.admin-vip-form-v200 textarea,.admin-vip-grant-v200 input,.admin-vip-delete-v200 input{width:100%;box-sizing:border-box;padding:11px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:#050912;color:#fff}.admin-vip-form-v200 small{font-weight:400;color:#94a3b8}.admin-vip-row-v200{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.admin-vip-format-v200{padding:12px;border-radius:12px;background:rgba(56,189,248,.07);border:1px solid rgba(56,189,248,.18);display:grid;gap:5px;color:#bae6fd;font-size:.78rem}.admin-vip-format-v200 code,.admin-vip-card-v200 code{word-break:break-all}.admin-vip-checks-v200{display:flex;gap:18px;flex-wrap:wrap}.admin-vip-checks-v200 label{display:flex;gap:7px;align-items:center}.admin-vip-checks-v200 input{width:auto}.admin-vip-list-v200{display:grid;gap:11px;align-content:start;max-height:1050px;overflow:auto}.admin-vip-list-head-v200 small{display:block;margin-top:4px;color:#7f8ea3;font-size:.72rem}.admin-vip-group-v613{gap:11px}.admin-vip-variants-v613{display:grid;gap:8px}.admin-vip-variant-v613{padding:10px;border-radius:11px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);display:grid;gap:8px}.admin-vip-variant-main-v613{display:flex;justify-content:space-between;gap:10px;align-items:center}.admin-vip-variant-main-v613 small{white-space:nowrap}.admin-vip-variant-access-v613{border-top:1px solid rgba(255,255,255,.06);padding-top:6px}.admin-vip-admin-head-v613{margin-top:8px;padding-top:12px;border-top:1px solid rgba(255,255,255,.09)}.admin-vip-admin-card-v613{border-color:rgba(250,204,21,.24);background:linear-gradient(180deg,rgba(250,204,21,.055),rgba(255,255,255,.025))}.admin-vip-card-v200{padding:14px;border-radius:15px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);display:grid;gap:8px}.admin-vip-card-head-v200{display:flex;justify-content:space-between}.admin-vip-card-head-v200 .on{color:#86efac}.admin-vip-card-head-v200 .off{color:#fca5a5}.admin-vip-card-v200 small{color:#94a3b8}.admin-vip-mini-items-v200{display:flex;flex-wrap:wrap;gap:5px}.admin-vip-mini-items-v200 span{font-size:.67rem;padding:5px 7px;border-radius:7px;background:rgba(255,255,255,.05)}.admin-vip-mini-items-v200 b{color:#7dd3fc}.admin-vip-actions-v200{display:flex;gap:7px}.admin-vip-actions-v200 a,.admin-vip-actions-v200 button,.admin-vip-grant-v200 button,.admin-vip-delete-v200 button,.admin-vip-active-v200 button{border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.07);color:#fff;padding:8px 10px;text-decoration:none;cursor:pointer}.admin-vip-card-v200 details{margin-top:4px}.admin-vip-card-v200 summary{cursor:pointer;color:#fda4af}.admin-vip-grant-v200,.admin-vip-delete-v200{display:grid;gap:7px;margin-top:9px}.admin-vip-delete-v200 button{border-color:rgba(239,68,68,.35);color:#fecaca}.admin-vip-empty-v200{padding:28px;text-align:center;color:#94a3b8}.admin-vip-active-v200{margin-top:18px}.admin-vip-active-v200>div{display:grid;gap:8px}.admin-vip-active-v200 article{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px;border-radius:10px;background:rgba(255,255,255,.035)}.admin-vip-active-v200 article span{display:grid;gap:3px}.admin-vip-active-v200 article small{color:#94a3b8}@media(max-width:980px){.admin-vip-layout-v200{grid-template-columns:1fr}.admin-vip-row-v200{grid-template-columns:1fr}.admin-vip-hero-v200{align-items:flex-start;flex-direction:column}.admin-vip-clean-v200{padding:22px 14px 60px}}

.admin-vip-manual-grant-v614{margin-top:14px;padding:14px;border:1px solid rgba(56,189,248,.24);border-radius:15px;background:linear-gradient(135deg,rgba(14,46,73,.28),rgba(7,11,18,.72))}.admin-vip-manual-head-v614{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:11px}.admin-vip-manual-head-v614 div{display:grid;gap:3px}.admin-vip-manual-head-v614 span{font-size:.62rem;font-weight:1000;letter-spacing:.14em;color:#7dd3fc}.admin-vip-manual-head-v614 strong{font-size:.88rem;color:#fff}.admin-vip-manual-head-v614 small{color:#8fa1b6;font-size:.67rem;text-align:right}.admin-vip-grant-manual-form-v614{display:grid;grid-template-columns:minmax(170px,1.2fr) minmax(150px,1fr) minmax(120px,.8fr) 82px auto;gap:8px;align-items:end}.admin-vip-grant-manual-form-v614 label{display:grid;gap:5px;color:#aebdcd;font-size:.66rem;font-weight:900}.admin-vip-grant-manual-form-v614 input,.admin-vip-grant-manual-form-v614 select{width:100%;box-sizing:border-box;background:#050b15;border:1px solid rgba(148,163,184,.2);border-radius:9px;color:#fff;padding:9px}.admin-vip-grant-manual-form-v614 button{border:0;border-radius:9px;padding:10px 12px;background:#0ea5e9;color:#fff;font-weight:950;cursor:pointer;white-space:nowrap}.admin-vip-variants-details-v614{margin-top:10px}.admin-vip-variants-details-v614>summary{cursor:pointer;color:#9fb0c3;font-size:.7rem;font-weight:900}.admin-vip-variants-details-v614[open]>summary{margin-bottom:9px}@media(max-width:1050px){.admin-vip-grant-manual-form-v614{grid-template-columns:1fr 1fr}.admin-vip-grant-manual-form-v614 button{grid-column:1/-1}.admin-vip-manual-head-v614{align-items:flex-start;flex-direction:column}.admin-vip-manual-head-v614 small{text-align:left}}
</style>
<%- include('../partials/footer') %>
