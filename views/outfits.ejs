</style>

<script>
(() => {
  const videos = Array.from(document.querySelectorAll('[data-vip-loop-video]'));
  if (!videos.length) return;

  const ensurePlaying = (video) => {
    if (!video || video.dataset.inView === '0' || document.hidden) return;
    video.muted = true;
    video.loop = true;
    const promise = video.play();
    if (promise && typeof promise.catch === 'function') promise.catch(() => {});
  };

  const observer = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.dataset.inView = entry.isIntersecting ? '1' : '0';
          if (entry.isIntersecting) ensurePlaying(entry.target);
          else entry.target.pause();
        });
      }, { threshold: 0.14 })
    : null;

  videos.forEach((video) => {
    video.dataset.inView = '1';
    video.controls = false;
    video.addEventListener('loadeddata', () => ensurePlaying(video));
    video.addEventListener('canplay', () => ensurePlaying(video));
    video.addEventListener('ended', () => {
      video.currentTime = 0;
      ensurePlaying(video);
    });
    video.addEventListener('pause', () => {
      if (video.dataset.inView !== '0' && !document.hidden) {
        setTimeout(() => ensurePlaying(video), 80);
      }
    });
    if (observer) observer.observe(video);
    ensurePlaying(video);
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) videos.forEach(ensurePlaying);
  });

  setInterval(() => {
    videos.forEach((video) => {
      if (video.dataset.inView !== '0' && video.paused && !document.hidden) ensurePlaying(video);
    });
  }, 1500);
})();
</script>

<%- include('partials/footer') %>
