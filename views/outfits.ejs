.vip-form-v300{display:grid;gap:14px}.vip-form-head-v300{display:flex;justify-content:space-between;gap:10px;align-items:end}.vip-options-v300{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.vip-option-v300{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:14px;border-radius:18px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.03);cursor:pointer;transition:.18s ease}.vip-option-v300:hover{border-color:rgba(248,113,113,.55);background:rgba(239,68,68,.07)}.vip-option-v300:has(input:checked){border-color:#ef4444;background:rgba(239,68,68,.12);box-shadow:0 0 0 1px rgba(239,68,68,.22) inset}.vip-option-v300 input{accent-color:#ef4444;width:18px;height:18px}.vip-option-main-v300{display:grid;gap:4px}.vip-option-main-v300 b{font-size:.96rem;line-height:1.15}.vip-option-main-v300 small{color:#8fa0b7;font-size:.73rem}.vip-option-v300 strong{font-size:1rem;white-space:nowrap}.vip-options-v300.is-static{grid-template-columns:repeat(2,minmax(0,1fr))}.vip-option-v300.is-static{grid-template-columns:1fr auto;cursor:default}
.vip-buy-button-v300{display:block;width:100%;border:0;border-radius:16px;padding:15px 18px;background:linear-gradient(135deg,#ef4444,#d1232a);color:#fff;font-weight:950;letter-spacing:.04em;text-decoration:none;text-align:center;cursor:pointer;box-shadow:0 18px 40px rgba(239,68,68,.26)}.vip-buy-button-v300.alt{margin-top:4px}
.vip-empty-v300{padding:54px;border-radius:26px;border:1px dashed rgba(255,255,255,.14);display:grid;gap:8px;text-align:center;background:rgba(255,255,255,.02)}.vip-empty-v300 strong{font-size:1.35rem}
@media(max-width:1180px){.vip-hero-v300{grid-template-columns:1fr}.vip-summary-v300{grid-template-columns:repeat(2,minmax(0,1fr))}.vip-card-v300{grid-template-columns:1fr}.vip-media-v300{min-height:420px}.vip-benefits-v300,.vip-options-v300,.vip-options-v300.is-static{grid-template-columns:1fr 1fr}.vip-top-v300{flex-direction:column}.vip-price-box-v300{min-width:unset}}
