.vip-benefits-v300{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.vip-benefits-v300 div{padding:14px 15px;border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);display:grid;gap:5px}.vip-benefits-v300 b{font-size:.85rem}.vip-benefits-v300 span{color:#aeb8c7;font-size:.8rem;line-height:1.45}
.vip-included-v300{display:grid;gap:10px}.vip-included-v300>strong,.vip-form-head-v300 strong{font-size:.74rem;letter-spacing:.14em;color:#cbd5e1}.vip-item-list-v300{display:flex;flex-wrap:wrap;gap:7px}.vip-item-list-v300 code{padding:8px 10px;border-radius:11px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.07);color:#dbeafe;font-size:.72rem}
