<%- include('partials/head') %>
<link rel="stylesheet" href="/css/zona-z-pages-v500.css?v=500">
<%- include('partials/nav') %>
<main class="vip-studio-v300">
  <%- include('partials/alerts') %>
  <div class="zz-cmd-strip">
    <span class="zz-cmd-dot"></span>
    <span class="zz-cmd-code">SETOR // <b>ELITE VIP</b></span>
    <span class="zz-cmd-tags"><span>Coleção premium</span><span>Ativação imediata</span><span>30 dias</span></span>
  </div>
  <% 
    const fmt = value => Number(value || 0).toLocaleString('pt-BR');
    const vipGroups = [];
    const groupMap = new Map();

    for (const outfit of (outfits || [])) {
      const rawName = String(outfit.name || 'Traje VIP');
      const parts = rawName.split(' • ');
      const baseName = parts.length > 1 ? parts[0].trim() : rawName;
      const variantName = parts.length > 1 ? parts.slice(1).join(' • ').trim() : rawName;
      const key = `${baseName}||${outfit.imageUrl || ''}`;

      if (!groupMap.has(key)) {
        const group = {
          key,
          name: baseName,
          description: outfit.description || '',
          imageUrl: outfit.imageUrl || '',
          durationDays: outfit.durationDays,
          variants: []
        };
        groupMap.set(key, group);
        vipGroups.push(group);
      }

      groupMap.get(key).variants.push({ ...outfit, variantName });
    }
  %>

  <section class="zz-banner zz-banner--vip" aria-label="Área VIP <%= appName %>">
    <div class="zz-banner-media" style="background-image:url('/images/zona-z/vip-hero.png')"></div>
    <div class="zz-banner-scrim"></div>
    <span class="zz-banner-corner tl"></span><span class="zz-banner-corner tr"></span>
    <span class="zz-banner-corner bl"></span><span class="zz-banner-corner br"></span>
    <div class="zz-banner-inner">
      <span class="zz-banner-kicker"><%= appName %> // Operadores de elite</span>
      <h1 class="zz-banner-title">Vista-se como <b>elite</b></h1>
      <p class="zz-banner-sub">Trajes táticos exclusivos com kit completo, combos e mochila à sua escolha. Ativação imediata e vinculada à sua conta por 30 dias.</p>
      <div class="zz-banner-tags"><span>Coleção premium</span><span>Ativação imediata</span><span>30 dias</span></div>
    </div>
    <div class="zz-banner-stats">
      <div><small>Trajes</small><strong><%= vipGroups.length %></strong></div>
      <div><small>Variações</small><strong><%= (outfits || []).length %></strong></div>
    </div>
  </section>

  <section class="vip-hero-v300">
    <div class="vip-hero-copy-v300">
      <span>TRAJES VIP • VITRINE REFORMULADA</span>
      <h1>Escolha seu traje com um visual mais premium.</h1>
      <p>Refizemos a vitrine para ficar mais profissional, proporcional e mais fácil de entender. O player vê o vídeo, confere o que acompanha no traje e escolhe a mochila em uma área bem mais organizada.</p>

      <div class="vip-summary-v300">
        <div><small>TRAJES</small><strong><%= vipGroups.length %></strong></div>
        <div><small>VARIAÇÕES</small><strong><%= (outfits || []).length %></strong></div>
        <div><small>DURAÇÃO</small><strong>30 DIAS</strong></div>
        <div><small>ATIVAÇÃO</small><strong>IMEDIATA</strong></div>
      </div>
    </div>

    <% if (activeOutfit) { %>
      <aside class="vip-active-v300">
        <small>SEU VIP ATIVO</small>
        <strong><%= activeOutfit.outfitTemplate?.name || activeOutfit.name || 'Traje VIP' %></strong>
        <span>Até <%= activeOutfit.expiresAt ? new Date(activeOutfit.expiresAt).toLocaleString('pt-BR') : '—' %></span>
        <p>Se comprar outro traje, a nova ativação será processada normalmente para sua conta.</p>
      </aside>
    <% } else { %>
      <aside class="vip-active-v300 is-neutral">
        <small>STATUS ATUAL</small>
        <strong>Nenhum traje ativo</strong>
        <span>Escolha sua cor favorita e ative direto pela loja.</span>
        <p>Todos os cards abaixo usam vídeo em loop contínuo enquanto estiverem visíveis.</p>
      </aside>
    <% } %>
  </section>

  <section class="vip-list-v300">
    <% vipGroups.forEach(group => {
      const first = group.variants[0];
      const firstItems = Array.isArray(first?.items) ? first.items : [];
      const commonItems = firstItems.filter(item => !['back','backpack'].includes(String(item.slot || '').toLowerCase()));
      const prices = group.variants.map(v => Number(v.priceCoins || 0)).filter(Boolean);
      const minPrice = prices.length ? Math.min(...prices) : 0;
      const maxPrice = prices.length ? Math.max(...prices) : 0;
      const starterFreeVariant = group.variants.find(variant => {
        const items = Array.isArray(variant.items) ? variant.items : [];
        const bag = items.find(item => ['back','backpack'].includes(String(item.slot || '').toLowerCase()));
        return String(variant.variantName || variant.name || '').toLowerCase().includes('assault pack 80 slots')
          || (String(bag?.classname || '').toLowerCase().includes('assault_pack') && String(bag?.label || '').includes('80'));
      });
    %>
      <article class="vip-card-v300">
        <div class="vip-media-v300">
          <% if (group.imageUrl) { %>
            <video
              src="<%= group.imageUrl %>"
              data-vip-loop-video
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              disablepictureinpicture
            ></video>
          <% } else { %>
            <div class="vip-no-video-v300">
              <b>VÍDEO 360°</b>
              <span>Adicione uma mídia para este traje no painel.</span>
            </div>
          <% } %>
          <div class="vip-media-badges-v300">
            <span><%= group.durationDays || 30 %> dias</span>
            <span><%= group.variants.length %> opções</span>
          </div>
        </div>

        <div class="vip-content-v300">
          <div class="vip-top-v300">
            <div>
              <span class="vip-label-v300">TRAJE VIP</span>
              <h2><%= group.name %></h2>
              <p><%= group.description || 'Traje VIP configurado para o servidor.' %></p>
            </div>

            <div class="vip-price-box-v300">
              <small>VALORES</small>
              <strong><%= fmt(minPrice) %> <%= currencyName %><% if (maxPrice && maxPrice !== minPrice) { %> <span>até <%= fmt(maxPrice) %> <%= currencyName %></span><% } %></strong>
            </div>
          </div>

          <div class="vip-benefits-v300">
            <div><b>Inclui</b><span>Colete + belt + pouch + IFAK + garrafa</span></div>
            <div><b>Combos</b><span>2 latas, 2 bandagens e Faca Tática</span></div>
            <div><b>Mochila</b><span>Escolha a opção ideal antes de ativar</span></div>
          </div>

          <div class="vip-included-v300">
            <strong>ITENS DO TRAJE</strong>
            <div class="vip-item-list-v300">
              <% commonItems.slice(0, 10).forEach(item => { %>
                <code>
                  <%= item.quantity || 1 %>x <%= item.label || item.classname %>
                  <% if (item.liquidPercent !== null && item.liquidPercent !== undefined) { %> • <%= item.liquidPercent %>%<% } %>
                  <% if (Array.isArray(item.attachments) && item.attachments.length) { %> • montado<% } %>
                </code>
              <% }) %>
            </div>
          </div>

          <% if (player) { %>
            <% if (starterVipBenefit?.eligible && starterFreeVariant) { %>
              <form method="POST" action="/outfits/free-7d" class="vip-free-v225">
                <input type="hidden" name="outfitId" value="<%= starterFreeVariant.id %>">
                <div>
                  <span>🎁 BENEFÍCIO DO KIT INICIAL</span>
                  <strong>7 DIAS GRÁTIS • MOCHILA 80 SLOTS</strong>
                  <small>Escolha esta cor/traje sem gastar <%= currencyName %>. Benefício disponível uma única vez por conta.</small>
                </div>
                <button type="submit">RESGATAR ESTE TRAJE GRÁTIS</button>
              </form>
            <% } else if (starterVipBenefit?.used && starterFreeVariant) { %>
              <div class="vip-free-v225 used">
                <div>
                  <span>✓ BENEFÍCIO DO KIT INICIAL</span>
                  <strong>VIP GRÁTIS JÁ UTILIZADO</strong>
                  <small>O benefício de 7 dias com mochila de 80 slots só pode ser usado uma vez.</small>
                </div>
              </div>
            <% } %>
            <form method="POST" action="/outfits/buy" class="vip-form-v300">
              <div class="vip-form-head-v300">
                <strong>ESCOLHA A MOCHILA</strong>
                <span>Selecione a variação que deseja comprar.</span>
              </div>

              <div class="vip-options-v300">
                <% group.variants.forEach((variant, variantIndex) => {
                  const items = Array.isArray(variant.items) ? variant.items : [];
                  const bag = items.find(item => ['back','backpack'].includes(String(item.slot || '').toLowerCase()));
                %>
                  <label class="vip-option-v300">
                    <input
                      type="radio"
                      name="outfitId"
                      value="<%= variant.id %>"
                      <%= variantIndex === 0 ? 'checked' : '' %>
                      required
                    >
                    <div class="vip-option-main-v300">
                      <b><%= variant.variantName %></b>
                      <small><%= bag?.label || bag?.classname || 'Mochila configurada' %></small>
                    </div>
                    <strong><%= fmt(variant.priceCoins) %> <%= currencyName %></strong>
                  </label>
                <% }) %>
              </div>

              <button type="submit" class="vip-buy-button-v300">ATIVAR VIP ESCOLHIDO</button>
            </form>
          <% } else { %>
            <div class="vip-options-v300 is-static">
              <% group.variants.forEach(variant => { %>
                <div class="vip-option-v300 is-static">
                  <div class="vip-option-main-v300">
                    <b><%= variant.variantName %></b>
                    <small>Abra a loja pelo jogo para comprar</small>
                  </div>
                  <strong><%= fmt(variant.priceCoins) %> <%= currencyName %></strong>
                </div>
              <% }) %>
            </div>
            <a class="vip-buy-button-v300 alt" href="/login">ABRIR PELO JOGO</a>
          <% } %>
        </div>
      </article>
    <% }) %>

    <% if (!vipGroups.length) { %>
      <div class="vip-empty-v300">
        <strong>Nenhum traje cadastrado.</strong>
        <span>A vitrine está pronta para receber novos VIPs.</span>
      </div>
    <% } %>
  </section>
</main>

<style>
