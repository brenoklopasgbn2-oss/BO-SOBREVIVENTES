.vip-media-badges-v300{position:absolute;left:14px;top:14px;display:flex;flex-wrap:wrap;gap:8px}.vip-media-badges-v300 span{padding:7px 10px;border-radius:999px;background:rgba(4,8,14,.78);border:1px solid rgba(255,255,255,.12);font-size:.68rem;font-weight:900;color:#f8fafc;backdrop-filter:blur(12px)}
