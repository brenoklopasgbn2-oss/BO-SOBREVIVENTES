<%- include('partials/head') %><link rel="stylesheet" href="/css/zona-z-pages-v500.css?v=500"><%- include('partials/nav') %>
<main style="max-width:1400px;margin:0 auto;padding:30px 18px 80px"><%- include('partials/alerts') %>
<section class="zz-banner zz-banner--ranking" style="min-height:300px"><div class="zz-banner-media" style="background-image:url('/images/zona-z/ranking-hero.png')"></div><div class="zz-banner-scrim"></div><div class="zz-banner-inner"><span class="zz-banner-kicker">TEMPORADA OFICIAL</span><h1 class="zz-banner-title">CAMPEONATO <b>CHAMPIONS Z</b></h1><p class="zz-banner-sub">Resultados registrados pela administração, pontos por evento e classificação oficial dos clãs.</p></div></section>
<section style="display:grid;grid-template-columns:1fr .9fr;gap:18px;margin-top:18px">
<article style="padding:20px;border:1px solid #333;background:#111;border-radius:16px"><h2>🏆 Classificação</h2><% clans.filter(c=>c.championshipRegistered).forEach((c,i)=>{ %><div style="display:grid;grid-template-columns:50px 1fr auto;align-items:center;gap:12px;padding:13px 0;border-top:1px solid #2c2c2c"><strong>#<%= i+1 %></strong><div><b>[<%= c.tag %>] <%= c.name %></b><br><small><%= c.members.length %>/5 • <%= c.eventWins %> vitórias • Flag: <%= c.selectedFlag?.name || '-' %></small></div><strong><%= coins(c.championshipPoints) %> pts</strong></div><% }) %><% if(!clans.some(c=>c.championshipRegistered)){ %><p>Nenhum clã inscrito ainda.</p><% } %></article>
<article style="padding:20px;border:1px solid #333;background:#111;border-radius:16px"><h2>🏳️ Bandeiras</h2><p>Escolhidas na inscrição e entregues pessoalmente pela administração.</p><% flags.filter(f=>f.status!=='DISABLED').slice(0,12).forEach(f=>{ %><div style="display:flex;gap:10px;align-items:center;padding:10px 0;border-top:1px solid #2c2c2c"><% if(f.imageData){ %><img src="/clan-flag-option/<%= f.id %>" style="width:72px;height:48px;object-fit:cover;border-radius:7px"><% } %><div><b><%= f.name %></b><br><small><%= f.status==='AVAILABLE'?'🟢 Disponível':f.status==='RESERVED'?'🟡 Reservada':'✅ Entregue' %></small></div></div><% }) %></article>
</section>
<section style="margin-top:18px;padding:20px;border:1px solid #333;background:#111;border-radius:16px"><h2>🎯 Histórico de resultados</h2><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px"><% results.forEach(r=>{ %><article style="border:1px solid #333;border-radius:12px;overflow:hidden;background:#0a0a0a"><% if(r.imageData){ %><img src="/championship-result-image/<%= r.id %>" style="width:100%;height:170px;object-fit:cover"><% } %><div style="padding:14px"><small><%= dateTime(r.occurredAt) %></small><h3><%= r.title || r.eventName %></h3><p><b>[<%= r.clan.tag %>] <%= r.clan.name %></b> • <strong><%= r.points>=0?'+':'' %><%= r.points %> pts</strong></p><p><%= r.description || '' %></p></div></article><% }) %></div></section>
</main><%- include('partials/footer') %>
