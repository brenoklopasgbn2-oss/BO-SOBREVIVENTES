<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="container streamer-panel-page support-streamer-page">
  <% const isAdminPreview = Boolean(typeof adminPreview !== 'undefined' && adminPreview); %>
  <style>
    .streamer-request-pay-v65{margin-top:14px;border:1px solid rgba(34,197,94,.24);background:linear-gradient(135deg,rgba(20,83,45,.22),rgba(15,23,42,.70));border-radius:20px;padding:16px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center}.streamer-request-pay-v65 form{display:flex;gap:8px;flex-wrap:wrap}.streamer-request-pay-v65 button{min-width:210px}.streamer-money-highlight-v65 strong{color:#bbf7d0}.streamer-money-highlight-v65 b{color:#fed7aa}.streamer-payout-list-v65{display:grid;gap:8px;margin-top:12px}.streamer-payout-row-v65{display:grid;grid-template-columns:1.4fr .8fr .8fr .8fr;gap:10px;align-items:center;border:1px solid rgba(148,163,184,.13);background:rgba(15,23,42,.50);border-radius:14px;padding:10px}.streamer-payout-row-v65 small{color:#9fb0c5}.streamer-supporter-summary-v158{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0 16px}.streamer-supporter-summary-v158>div{border:1px solid rgba(148,163,184,.15);border-radius:15px;padding:12px;background:rgba(15,23,42,.48)}.streamer-supporter-summary-v158 span{display:block;color:#94a3b8;font-size:12px}.streamer-supporter-summary-v158 strong{font-size:22px}.streamer-supporter-tags-v158{display:flex;gap:6px;flex-wrap:wrap}.streamer-supporter-tags-v158 .pill{font-size:11px}@media(max-width:800px){.streamer-request-pay-v65,.streamer-payout-row-v65{grid-template-columns:1fr}.streamer-request-pay-v65 form{display:grid}.streamer-request-pay-v65 button{min-width:0}.streamer-supporter-summary-v158{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>
  <% if (isAdminPreview) { %>
    <div class="alert success" style="margin-top:18px">Visualização do ADM: este painel abriu corretamente. Os botões de alteração ficam bloqueados nesta prévia.</div>
  <% } %>
  <section class="zz-page-visual zz-page-visual--streamer" aria-label="Parceiros <%= appName %>"><div><span><%= appName %> // PARCEIROS</span><strong>Seu código. Sua comunidade. Seu painel.</strong><small>Comissões, apoiadores e gestão streamer em um só lugar.</small></div></section>

  <div class="zz-cmd-strip">
    <span class="zz-cmd-dot"></span>
    <span class="zz-cmd-code">SETOR // <b>PARCEIROS</b></span>
    <span class="zz-cmd-tags"><span>Painel streamer</span><span>Cupom próprio</span><span>Comissões</span></span>
  </div>
  <section class="shop-header support-hero-card sz-hover-card">
    <div>
      <p class="eyebrow"><%= isAdminPreview ? 'Prévia do ADM' : 'Painel Streamer' %></p>
      <h1>Comissão nas compras de moedas</h1>
      <p class="muted"><%= isAdminPreview ? 'Prévia segura aberta pelo painel ADM.' : 'Painel protegido aberto pelo DayZ. A comissão entra somente quando um player compra moedas por Pix usando seu código. Saldo colocado pelo ADM, prêmios e compras de itens não contam.' %></p>
    </div>
    <div class="dm-status-stack"><span class="pill success">Apoio ativo</span><span class="pill">Saque semanal</span><span class="pill">DM bloqueado</span></div>
  </section>

  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert success"><%= success %></div><% } %>


    <% const sc = streamerDashboard.streamerCode; const stats = streamerDashboard.stats; const sales = streamerDashboard.sales; const payouts = streamerDashboard.payouts || []; const totalStats = stats.total || {}; const weekStats = stats.weekly || {}; const monthStats = stats.monthly || {}; const todayStats = stats.today || {}; const pendingStats = stats.pending || {}; const pendingWeek = stats.pendingWeekly || {}; const pendingMonth = stats.pendingMonthly || {}; %>
    <section class="card streamer-config-card">
      <div class="item-builder-top">
        <div>
          <p class="eyebrow">Logado como streamer</p>
          <h2><%= sc.streamerName %></h2>
          <p class="muted">Seu código para compra de moedas: <code class="streamer-code-big-v43"><%= sc.code %></code> • Steam64 liberado: <strong><%= sc.streamerSteam64 || 'Não informado' %></strong> • Comissão: <strong><%= sc.percent %>%</strong><% if (sc.pixKey) { %> • Chave Pix: <%= sc.pixKey %><% } %></p>
        </div>
        <span class="pill success">Ativo</span>
      </div>
      <div class="stats-grid streamer-stats-v43">
        <div class="stat premium-stat-v43"><span>Hoje</span><strong><%= coins(todayStats.totalCommissionCoins || 0) %> <%= currencyName %></strong><small><%= todayStats.saleCount || 0 %> compras de moedas • ≈ <%= brl(todayStats.totalCommissionBrl || 0) %></small></div>
        <div class="stat premium-stat-v43"><span>Semana</span><strong><%= coins(weekStats.totalCommissionCoins || 0) %> <%= currencyName %></strong><small><%= weekStats.saleCount || 0 %> compras de moedas • ≈ <%= brl(weekStats.totalCommissionBrl || 0) %></small></div>
        <div class="stat premium-stat-v43"><span>Mês</span><strong><%= coins(monthStats.totalCommissionCoins || 0) %> <%= currencyName %></strong><small><%= monthStats.saleCount || 0 %> compras de moedas • ≈ <%= brl(monthStats.totalCommissionBrl || 0) %></small></div>
        <div class="stat premium-stat-v43 streamer-money-highlight-v65"><span>A receber agora</span><strong><%= coins(pendingStats.totalCommissionCoins || 0) %> <%= currencyName %></strong><small>≈ <%= brl(pendingStats.totalCommissionBrl || 0) %> pendente</small></div>
      </div>
      <div class="streamer-public-summary-v43">
        <div><span>Pendente semana</span><strong><%= coins(pendingWeek.totalCommissionCoins || 0) %> <%= currencyName %></strong><small>≈ <%= brl(pendingWeek.totalCommissionBrl || 0) %></small></div>
        <div><span>Pendente mês</span><strong><%= coins(pendingMonth.totalCommissionCoins || 0) %> <%= currencyName %></strong><small>≈ <%= brl(pendingMonth.totalCommissionBrl || 0) %></small></div>
        <div><span>Total histórico</span><strong><%= coins(totalStats.totalCommissionCoins || 0) %> <%= currencyName %></strong><small>≈ <%= brl(totalStats.totalCommissionBrl || 0) %> desde o começo.</small></div>
      </div>
      <div class="streamer-request-pay-v65">
        <div>
          <h3>Solicitar pagamento semanal</h3>
          <p class="muted">O streamer pode solicitar 1 vez por semana. O ADM confere e marca como pago usando senha no painel admin.</p>
        </div>
        <% if (isAdminPreview && isAdminLogged) { %>
          <a class="btn" href="/admin/streamer">Voltar ao painel ADM</a>
        <% } else { %>
          <form method="POST" action="/streamer/request-payout">
            <button class="btn primary" type="submit">Solicitar saque da semana</button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="card wide-card">
      <div class="item-builder-top"><h2>Pagamentos / solicitações</h2><span class="pill"><%= payouts.length %> registros</span></div>
      <% if (!payouts.length) { %>
        <p class="muted">Ainda não tem pagamento marcado nem solicitação aberta.</p>
      <% } else { %>
        <div class="streamer-payout-list-v65">
          <% payouts.slice(0, 20).forEach(p => { %>
            <div class="streamer-payout-row-v65">
              <div><strong><%= p.periodType === 'WEEKLY' ? 'Saque semanal' : p.periodType %></strong><br><small><%= p.requestedByStreamer ? 'Solicitado pelo streamer' : 'Criado pelo ADM' %></small></div>
              <div><span class="status <%= p.status === 'PAID' ? 'paid' : 'pending' %>"><%= p.status === 'PAID' ? 'PAGO' : 'PENDENTE' %></span><br><small><%= dateTime(p.paidAt || p.requestedAt || p.createdAt) %></small></div>
              <div><%= coins(p.amountCoins || 0) %> <%= currencyName %><br><small>≈ <%= brl(p.amountBrl || 0) %></small></div>
              <div><%= p.saleCount || 0 %> compras de moedas<br><small><%= p.supporters || 0 %> compradores únicos</small></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="card wide-card">
      <div class="item-builder-top"><h2>Histórico de compras de moedas com apoio</h2><span class="pill"><%= sales.length %> registros</span></div>
      <table>
        <thead><tr><th>Data</th><th>Player</th><th>Tipo</th><th>Total</th><th>Comissão</th><th>Status</th><th>Cupom</th></tr></thead>
        <tbody>
          <% if (!sales.length) { %><tr><td colspan="7" class="muted">Ainda não houve compra de moedas por Pix usando seu código.</td></tr><% } %>
          <% sales.forEach(s => { %>
            <tr>
              <td><%= dateTime(s.createdAt) %></td>
              <td><%= s.playerName || 'Player' %><br><small><%= s.playerSteam64 || '-' %></small></td>
              <td><span class="pill">Compra de moedas Pix</span></td>
              <td><%= coins(s.totalCoins || 0) %> <%= currencyName %><br><small>≈ <%= brl((s.totalCoins || 0) / 1000) %></small></td>
              <td><%= s.commissionPercent %>% = <%= coins(s.commissionCoins || 0) %> <%= currencyName %><br><small>≈ <%= brl((s.commissionCoins || 0) / 1000) %></small></td>
              <td><span class="status <%= s.paidAt ? 'paid' : 'pending' %>"><%= s.paidAt ? 'PAGO' : 'PENDENTE' %></span></td>
              <td><%= s.couponCode || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

  <% const supporters = streamerDashboard.supporters || []; const supporterStats = streamerDashboard.supporterStats || {}; %>
  <section class="card wide-card">
    <div class="item-builder-top"><div><h2>Players que usaram seu código</h2><p class="muted">Aqui aparecem todos que resgataram a skin do streamer e todos que apoiaram em compra de moedas.</p></div><span class="pill"><%= supporters.length %> players únicos</span></div>
    <div class="streamer-supporter-summary-v158">
      <div><span>Players únicos</span><strong><%= supporterStats.uniquePlayers || 0 %></strong></div>
      <div><span>Resgataram a skin</span><strong><%= supporterStats.skinRedeemers || 0 %></strong></div>
      <div><span>Apoiaram com moedas</span><strong><%= supporterStats.coinSupporters || 0 %></strong></div>
      <div><span>Fizeram os dois</span><strong><%= supporterStats.both || 0 %></strong></div>
    </div>
    <table>
      <thead><tr><th>Player</th><th>Como apoiou</th><th>Skin</th><th>Compras de moedas</th><th>Comissão gerada</th><th>Última atividade</th></tr></thead>
      <tbody>
        <% if (!supporters.length) { %><tr><td colspan="6" class="muted">Ainda nenhum player usou seu código para resgatar a skin ou comprar moedas.</td></tr><% } %>
        <% supporters.forEach(row => { %>
          <tr>
            <td><strong><%= row.playerName || 'Player' %></strong><br><small><%= row.steam64 %></small></td>
            <td><div class="streamer-supporter-tags-v158"><% if (row.skinClaims > 0) { %><span class="pill success">Resgatou skin</span><% } %><% if (row.purchaseCount > 0) { %><span class="pill">Apoiou moedas</span><% } %></div></td>
            <td><% if (row.skinClaims > 0) { %><%= row.skinName || 'Skin do streamer' %><br><small><%= row.skinStatus === 'ACTIVE' ? 'ATIVA' : row.skinStatus || '-' %> • resgatada em <%= dateTime(row.skinClaimedAt) %><% if (row.skinExpiresAt) { %> • vence <%= dateTime(row.skinExpiresAt) %><% } %></small><% } else { %>-<% } %></td>
            <td><%= row.purchaseCount || 0 %><br><small><%= coins(row.totalCoins || 0) %> <%= currencyName %> compradas</small></td>
            <td><%= coins(row.commissionCoins || 0) %> <%= currencyName %><br><small>≈ <%= brl((row.commissionCoins || 0) / 1000) %></small></td>
            <td><%= dateTime(row.lastPurchaseAt || row.skinClaimedAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section class="shop-header support-hero-card sz-hover-card" style="margin-top:24px">
    <div><p class="eyebrow">Traje do streamer</p><h1>Gerenciar usuários do traje</h1><p class="muted">Adicione ou remova os players autorizados. O streamer dono não paga. A bandeira é dropada separadamente pelo botão e não vem dentro do traje.</p></div>
  </section>
  <%- include('partials/managedOutfits', { managedOutfits, managerReturnTo, adminPreview: isAdminPreview }) %>

  <section class="card dm-rules-summary">
    <h2>Death Match Interativo</h2>
    <p class="muted">Esse painel está bloqueado por enquanto porque ainda está em desenvolvimento. Quando liberar, essa área vai mostrar as configurações de presentes da live.</p>
    <div class="stats-grid">
      <div class="stat"><span>Status</span><strong>Bloqueado</strong><small>Em desenvolvimento</small></div>
      <div class="stat"><span>Loja DM</span><strong>Bloqueada</strong><small>Sem acesso para players</small></div>
      <div class="stat"><span>Chamado ADM</span><strong>Bloqueado</strong><small>Sem mexer por enquanto</small></div>
      <div class="stat"><span>Apoio</span><strong>Ativo</strong><small>Use o código na compra de moedas Pix</small></div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
