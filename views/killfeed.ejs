<%- include('partials/head') %><link rel="stylesheet" href="/css/zona-z-pages-v500.css?v=500"><%- include('partials/nav') %>
<main style="max-width:1400px;margin:0 auto;padding:30px 18px 80px"><%- include('partials/alerts') %>
<section style="padding:24px;border:1px solid #333;background:#111;border-radius:16px"><p class="eyebrow">TELEMETRIA DO SERVIDOR</p><h1>☠️ KILLFEED • CHAMPIONS Z</h1><p>Killer, vítima, arma, distância e coordenadas recebidas pela API leve do mod.</p>
<div style="overflow:auto"><table style="width:100%;border-collapse:collapse"><thead><tr><th>Data</th><th>Killer</th><th>Vítima</th><th>Arma / causa</th><th>Dist.</th><th>Killer XYZ</th><th>Vítima XYZ</th></tr></thead><tbody>
<% kills.forEach(k => { %><tr style="border-top:1px solid #2b2b2b"><td style="padding:11px"><%= dateTime(k.occurredAt) %></td><td><b><%= k.killerClan ? '['+k.killerClan.tag+'] ' : '' %><%= k.killerName || k.killerSteam64 %></b><br><small><%= k.killerSteam64 %></small></td><td><%= k.victimClan ? '['+k.victimClan.tag+'] ' : '' %><%= k.victimName || k.victimSteam64 %><br><small><%= k.victimSteam64 %></small></td><td><%= k.weapon || k.sourceClassname || k.cause || '-' %><%= k.headshot ? ' 🎯 HS' : '' %></td><td><%= k.distanceMeters ? Math.round(k.distanceMeters)+'m' : '-' %></td><td><%= k.killerPosX != null ? [Math.round(k.killerPosX),Math.round(k.killerPosY||0),Math.round(k.killerPosZ)].join(' / ') : '-' %></td><td><%= k.victimPosX != null ? [Math.round(k.victimPosX),Math.round(k.victimPosY||0),Math.round(k.victimPosZ)].join(' / ') : '-' %></td></tr><% }) %>
</tbody></table></div><% if (!kills.length) { %><p>Nenhuma kill recebida ainda.</p><% } %></section></main><%- include('partials/footer') %>
